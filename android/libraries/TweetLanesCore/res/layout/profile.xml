<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/profile_scroll_view"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fadingEdge="none">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#333"
                android:padding="12dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                <ImageView
                        android:id="@+id/profileImage"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_contact_picture"
                        android:layout_marginEnd="20dp" />

                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <TextView
                            android:textColor="#fff"
                            android:id="@+id/fullNameTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical|start"
                            android:text="Android Central"
                            android:drawablePadding="5dp"
                            android:textAppearance="?android:attr/textAppearanceLarge" />

                    <TextView
                            android:textColor="#fff"
                            android:id="@+id/followState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/follows_you"
                            android:alpha="0.5"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textSize="13sp" />

                    <Button
                            android:textColor="#fff"
                            android:id="@+id/friendship_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_unfollow" />
                </LinearLayout>
            </LinearLayout>


            <TextView
                    android:textColor="#fff"
                    android:id="@+id/bioTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading bio..."
                    android:alpha="0.8"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:linksClickable="true"
                    android:layout_margin="12dp" />

            <TextView
                    android:textColor="#fff"
                    android:id="@+id/link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="androidcentral.com"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:linksClickable="true"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />


            <TextView
                    android:textColor="#fff"
                    android:id="@+id/location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manchester, UK"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

        </LinearLayout>

        <TableLayout
                android:id="@+id/details_table_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

            <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                <TextView
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_gravity="center_vertical|start"
                        android:layout_weight=".5"
                        android:gravity="start"
                        android:textAlignment="viewStart"
                        android:text="@string/status_count" />

                <TextView
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_gravity="center_vertical|end"
                        android:layout_weight=".5"
                        android:gravity="end"
                        android:textAlignment="viewEnd"
                        android:id="@+id/tweetCountLabel"
                        android:text="777" />
            </TableRow>

            <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                <TextView
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_gravity="center_vertical|start"
                        android:layout_weight=".5"
                        android:gravity="start"
                        android:textAlignment="viewStart"
                        android:text="@string/friends_count" />

                <TextView
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_gravity="center_vertical|end"
                        android:layout_weight=".5"
                        android:gravity="end"
                        android:textAlignment="viewEnd"
                        android:id="@+id/followingCountLabel"
                        android:text="888" />
            </TableRow>

            <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                <TextView
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_gravity="center_vertical|start"
                        android:layout_weight=".5"
                        android:gravity="start"
                        android:textAlignment="viewStart"
                        android:text="@string/following_count" />

                <TextView
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_gravity="center_vertical|end"
                        android:layout_weight=".5"
                        android:gravity="end"
                        android:textAlignment="viewEnd"
                        android:id="@+id/followersCountLabel"
                        android:text="54455" />
            </TableRow>

            <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                <TextView
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_gravity="center_vertical|start"
                        android:layout_weight=".5"
                        android:gravity="start"
                        android:textAlignment="viewStart"
                        android:text="@string/favorites_count" />

                <TextView
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_gravity="center_vertical|end"
                        android:layout_weight=".5"
                        android:gravity="end"
                        android:textAlignment="viewEnd"
                        android:id="@+id/favorites_count"
                        android:text="45" />
            </TableRow>

        </TableLayout>


    </LinearLayout>
</ScrollView>
